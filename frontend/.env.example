# Base URL of the Django backend API (no trailing slash).
# Leave EMPTY in local development: the Vite dev server proxies /api and
# /media to http://127.0.0.1:8000. Set it to your deployed API origin
# (e.g. https://your-backend.example.com) for production.
VITE_API_BASE_URL=

# Clerk authentication (from dashboard.clerk.com -> API keys)
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Third-party event sources used by client-side external-events search
VITE_TICKETMASTER_API_KEY=your_ticketmaster_api_key_here
VITE_SKIDDLE_API_KEY=your_skiddle_api_key_here

# Note: never commit real values. Copy this file to .env and fill in values.
